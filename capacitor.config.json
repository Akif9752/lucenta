{
  "appId": "app.lucenta.ios",
  "appName": "Lucenta",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": true,
    "backgroundColor": "#F5F6EF"
  },
  "server": {
    "iosScheme": "lucenta"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#E4E6DB",
      "showSpinner": false
    }
  }
}
