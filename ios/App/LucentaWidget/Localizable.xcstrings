  "strings": {
    "Check-in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagesform"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily check-in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro diario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relevé du jour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diario giornaliero"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registo diário"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük durum"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の記録"
          }
        }
      }
    },
    "See which times of day you have logged, and log mood and energy right here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, welche Tageszeiten eingetragen sind, und trag Stimmung und Energie direkt hier ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See which times of day you have logged, and log mood and energy right here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué momentos del día has registrado y anota ánimo y energía aquí mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir les moments de la journée déjà notés et noter humeur et énergie ici même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda quali momenti della giornata hai registrato e annota umore ed energia direttamente qui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja que momentos do dia já registou e registe humor e energia aqui mesmo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün hangi zamanlarını kaydettiğini gör, ruh halini ve enerjini doğrudan buradan gir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの時間帯を記録したか確認し、気分とエネルギーをここから直接記録できます。"
          }
        }
      }
    },
