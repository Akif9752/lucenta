<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <!-- Runde 107, gemeldet: "Der Lucenta-Ladebildschirm beim Oeffnen der App sieht noch zu haesslich
         aus und ist ausserdem zu gross."

         Die Groesse war messbar, nicht Geschmack. Bis hier war die WURZELANSICHT selbst der
         UIImageView, mit contentMode="scaleAspectFill" und dem 2732x2732 grossen "Splash". Bei
         aspectFill skaliert ein Quadrat nach der GROESSEREN Bildschirmkante, also nach der Hoehe:
         auf 402x874 Punkten mit dem Faktor 874/2732 = 0,32. Der Logo-Block im Bild ist 1028 Punkte
         breit (nachgemessen am Bildpunkt, nicht geschaetzt: 37,6 % der Bildbreite, der Rest ist
         Papierfarbe) und kam damit auf 329 von 402 Punkten heraus — 82 % der Bildschirmbreite.
         Nebenbei wurde das Bild links und rechts beschnitten, weil aspectFill ein Quadrat auf einem
         19,5:9-Schirm zwangslaeufig ueberfuellt.

         Statt aspectFill traegt jetzt eine gewoehnliche UIView den Hintergrund, und das Bild liegt
         mittig darin mit aspectFit und einer Breite von 0,85 der Ansichtsbreite. Der Logo-Block
         landet damit bei 0,85 x 37,6 % = 32 % der Bildschirmbreite — auf jedem Geraet gleich, weil
         der Wert ein Anteil ist und kein Punktmass. Kein Beschnitt mehr, keine Abhaengigkeit vom
         Seitenverhaeltnis.

         Zwei Dinge, die das erst moeglich machen:
         1. Der Hintergrund der beiden PNG ist EXAKT das CSS-Token „paper" (#E4E6DB hell, #0F1613 dunkel,
            nachgemessen am Bildpunkt). Die Farbe "Papier" im Asset-Katalog traegt dieselben zwei
            Werte. Deshalb ist die Kante des quadratischen Bildes auf der Flaeche unsichtbar und die
            Grafik musste nicht neu gerendert werden.
         2. Die Groesse wirkt an ZWEI Stellen. @capacitor/splash-screen baut seine eigene Anzeige
            nicht selbst, sondern instanziert dieses Storyboard (SplashScreen.swift, buildViews():
            UIStoryboard(name: UILaunchStoryboardName)). System-Startbild und Plugin-Splash sind
            also dieselbe Datei — eine Aenderung hier wirkt auf beide, und der Uebergang bleibt
            nahtlos.

         Dazu gehoert eine Aenderung in capacitor.config.json: plugins.SplashScreen.backgroundColor
         ist entfallen. Das Plugin setzt diesen Wert auf die Wurzelansicht des Storyboards
         (showSplash()). Solange die Wurzel der deckende UIImageView war, blieb das wirkungslos;
         jetzt waere es sichtbar — und der Wert war eine FESTE Farbe (#E4E6DB), also die Hellfassung
         auch im Dunkelmodus. Ohne den Eintrag bleibt die dynamische Farbe "Papier" stehen. -->
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22505"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="LUC-vw-grnd">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="Splash" translatesAutoresizingMaskIntoConstraints="NO" id="LUC-im-mrke">
                                <rect key="frame" x="29.5" y="259.5" width="334" height="334"/>
                                <constraints>
                                    <constraint firstAttribute="width" secondItem="LUC-im-mrke" secondAttribute="height" multiplier="1:1" id="LUC-cn-quad"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="LUC-lg-safe"/>
                        <color key="backgroundColor" name="Papier"/>
                        <constraints>
                            <constraint firstItem="LUC-im-mrke" firstAttribute="centerX" secondItem="LUC-vw-grnd" secondAttribute="centerX" id="LUC-cn-mitx"/>
                            <constraint firstItem="LUC-im-mrke" firstAttribute="centerY" secondItem="LUC-vw-grnd" secondAttribute="centerY" id="LUC-cn-mity"/>
                            <constraint firstItem="LUC-im-mrke" firstAttribute="width" secondItem="LUC-vw-grnd" secondAttribute="width" multiplier="0.85" id="LUC-cn-brte"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="Splash" width="2732" height="2732"/>
        <namedColor name="Papier">
            <color red="0.89411764705882357" green="0.90196078431372551" blue="0.85882352941176465" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
