<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <!-- Runde 122: Das Startbild ist nur noch die Papierflaeche, ohne Bild.

         Am Simulator gemessen (Kaltstart, Randfarbe je Bildschirmfoto): ~4,5 s SCHWARZ, danach
         ~2 s die helle Flaeche mit einem beigen Quadrat, dann die App. Zwei Fehler:
         1. Das Quadrat: "Splash" (2732x2732) trug noch die Papierfarbe von vor Runde 120 (#E4E6DB),
            die Flaeche dahinter ist seitdem #F2F2F7. Die Kante, die Runde 107 unsichtbar gemacht
            hatte, war wieder da.
         2. Das Schwarz: iOS hatte fuer Lucenta keinen Startbild-Schnappschuss abgelegt
            (Library/SplashBoard leer) und zeigte stattdessen Schwarz. Ein 2732x2732-RGBA-Bild sind
            entpackt rund 30 MB; Startbilder unterliegen einer Speichergrenze, und ein zu grosses Bild
            ist die bekannte Ursache fuer genau dieses Schwarz.

         Ein neues, kleineres Bild haette beides behoben. Es haette aber den Namen gezeigt, der eine
         halbe Sekunde spaeter in der Startbewegung (startBewegung() in 21-beta-rueckmeldung.js)
         noch einmal erscheint und sich dort erst ZEICHNET — ein fertiges Logo, das verschwindet und
         sich dann neu aufbaut. Apple sieht fuer das Startbild ohnehin keine Marke vor, sondern die
         leere erste Ansicht. Also: nur "Papier", hell #F2F2F7, dunkel #000000.

         Weiterhin gilt aus Runde 107: @capacitor/splash-screen instanziert DIESE Datei als eigenen
         Splash. plugins.SplashScreen.backgroundColor darf deshalb nicht gesetzt werden, sonst
         stuende dort eine feste Farbe statt der dynamischen. -->
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22505"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="LUC-vw-grnd">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <viewLayoutGuide key="safeArea" id="LUC-lg-safe"/>
                        <color key="backgroundColor" name="Papier"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <namedColor name="Papier">
            <color red="0.94901960784313721" green="0.94901960784313721" blue="0.96862745098039216" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
