    "Logs mood and energy for the current time of day, without opening the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trägt Stimmung und Energie für die laufende Tageszeit ein, ohne die App zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs mood and energy for the current time of day, without opening the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra ánimo y energía del momento del día sin abrir la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note humeur et énergie pour le moment de la journée, sans ouvrir l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra umore ed energia per il momento della giornata, senza aprire l’app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista humor e energia do momento do dia, sem abrir a app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı açmadan günün şu anki zamanı için ruh hali ve enerjiyi kaydeder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開かずに、今の時間帯の気分とエネルギーを記録します。"
          }
        }
      }
    },
