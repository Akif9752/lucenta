    "How is your mood, from 1 to 5?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie ist deine Stimmung, von 1 bis 5?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How is your mood, from 1 to 5?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo está tu ánimo, del 1 al 5?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment est ton humeur, de 1 à 5 ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Com’è il tuo umore, da 1 a 5?"
