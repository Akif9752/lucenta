            "state": "translated",
            "value": "Ruh halin nasıl, 1'den 5'e?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気分は1から5でどれくらいですか？"
          }
        }
      }
    },
